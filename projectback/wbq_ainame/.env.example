# 知名台后端环境变量示例
#
# 1. 将本文件复制为 .env。
# 2. 替换所有 change-me 和 replace-with-* 占位值。
# 3. 不要提交包含真实密码、令牌、私钥或 API Key 的 .env。


# =============================================================================
# 基础数据库与安全
# =============================================================================

# MySQL 业务数据库，供 SQLAlchemy 和 Alembic 使用。
DB_URI=mysql+aiomysql://ainame_user:change-me@127.0.0.1:3306/ainame

# LangGraph 检查点 PostgreSQL。变量名按现有代码保留为 POST_GRESQL_DB。
POST_GRESQL_DB=postgresql://ainame_user:change-me@127.0.0.1:5432/ainame_memory

# JWT 签名密钥；生产环境请使用至少 32 个字符的随机值。
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# 首任管理员网页初始化密钥。留空时关闭初始化入口。
ADMIN_BOOTSTRAP_SECRET=


# =============================================================================
# 应用、CORS 与数据库日志
# =============================================================================

APP_BASE_URL=http://127.0.0.1:8000

# 多个精确前端来源使用英文逗号分隔，不要包含页面路径。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# 可选；默认正则已允许 localhost、127.0.0.1 和常见局域网地址。
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(1[6-9]|2\d|3[0-1])\.\d+\.\d+)(:\d+)?$

# true 会输出 SQL 和参数，仅建议在本地排错时开启。
SQL_ECHO=false

# 知识库 PDF/TXT 单文件上传上限，单位为字节；10485760 = 10 MiB。
MAX_UPLOAD_SIZE=10485760


# =============================================================================
# Redis 与邮件服务
# =============================================================================

# 注册验证码和换绑邮箱验证码使用。
REDIS_URL=redis://127.0.0.1:6379/0

MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=no-reply@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_FROM_NAME=知名台
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true


# =============================================================================
# AI 模型服务
# =============================================================================

# AI 起名使用。
DEEP_SEEKER_API_KEY=replace-with-deepseek-api-key

# Logo 生成使用。
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
DASHSCOPE_BASE_URL=replace-with-dashscope-base-url
WANXIANG_MODEL=wan2.6-t2i


# =============================================================================
# 知识库、RabbitMQ、Chroma 与 Ollama
# =============================================================================

RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# Chroma 相对路径会以后端目录为基准。
CHROMDB_PATH=chroma_rag_db

# 可选上传目录覆盖。不设置时使用 projectback/wbq_ainame/uploader。
# UPLOAD_FOLDER=D:/data/ainame/uploads

OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_REQUEST_TIMEOUT=180

RAG_EMBED_BATCH_SIZE=8
RAG_EMBED_MAX_ATTEMPTS=4
RAG_EMBED_RETRY_DELAY=3
RAG_TOP_K=3

# 默认不设置固定分数门槛。仅在针对当前向量模型完成校准后取消注释。
# RAG_PRIMARY_MIN_SCORE=0.65
# RAG_FALLBACK_MIN_SCORE=0.55


# =============================================================================
# 支付宝、支付对账与退款
# =============================================================================

# 本地不测试支付时保持 false。
PAYMENT_ENABLED=false
ALIPAY_ENVIRONMENT=sandbox

# 支付功能关闭时可暂时留空；启用前必须填写同一环境的整套参数。
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

PAYMENT_FRONTEND_RESULT_URL=http://127.0.0.1:8080/#/pages/payment/result
PAYMENT_ORDER_TIMEOUT_MINUTES=60
PAYMENT_RECONCILE_INTERVAL_SECONDS=30
PAYMENT_RECONCILE_BATCH_SIZE=50
REFUND_WINDOW_HOURS=24

# 可选；留空时会根据普通支付回调地址推导专家订单回调地址。
EXPERT_ALIPAY_NOTIFY_URL=
EXPERT_ALIPAY_RETURN_URL=


# =============================================================================
# 后台清理任务与专家私有存储
# =============================================================================

ACCOUNT_CLEANUP_INTERVAL_SECONDS=60
ACCOUNT_CLEANUP_BATCH_SIZE=10
ORDER_CLEANUP_INTERVAL_SECONDS=300

# 可选；不设置时使用 projectback/wbq_ainame/private_storage/expert。
# 不要写成空值，否则空路径会被解析为当前工作目录。
# EXPERT_PRIVATE_STORAGE_DIR=D:/data/ainame/expert-private
