@baseUrl = http://127.0.0.1:8000
@testEmail = replace_with_your_test_email@example.com
@testPassword = replace_with_your_local_password
@accessToken = replace_with_access_token_after_login
@refreshToken = replace_with_refresh_token_after_login

### 健康检查
GET {{baseUrl}}/
Accept: application/json

### 示例接口
GET {{baseUrl}}/hello/User
Accept: application/json

### 发送注册验证码
GET {{baseUrl}}/auth/code?email={{testEmail}}
Accept: application/json

### 注册（新密码必须为8至64位）
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "username": "tester",
  "password": "{{testPassword}}",
  "confirm_password": "{{testPassword}}",
  "code": "0000"
}

### 登录
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### 刷新 access token
POST {{baseUrl}}/auth/refresh
Authorization: Bearer {{refreshToken}}

### 起名
POST {{baseUrl}}/name/generate
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "category": "企业名",
  "length": "不限",
  "other": "一个科技公司，制造芯片",
  "exclude": []
}

### 起名反馈：先替换为上一步返回的 thread_id
POST {{baseUrl}}/name/feedback
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "thread_id": "replace_with_thread_id",
  "category": "企业名",
  "feedback": "保留喜欢的名字，其余方案更加简洁。"
}

### 查询次数
GET {{baseUrl}}/credit/balance
Authorization: Bearer {{accessToken}}

### 套餐列表
GET {{baseUrl}}/packages/list

### 创建支付宝沙箱订单
POST {{baseUrl}}/pay/create_order
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "package_id": 1
}

### 上传知识库
POST {{baseUrl}}/knowledge/upload
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: Bearer {{accessToken}}

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="company_rules.txt"
Content-Type: text/plain

< ./company_rules.txt
--WebAppBoundary--

### 生成 Logo（需要登录）
POST {{baseUrl}}/logos/generate
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "company_name": "青衍科技",
  "style_feedback": "图片中不要加汉字"
}

### 支付宝回调 /pay/paySuccess 和 /pay/success 由支付宝请求，不应手工模拟
